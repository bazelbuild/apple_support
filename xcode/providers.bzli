    "default_macos_sdk_version": str | None,
    "default_tvos_sdk_version": str | None,
    "default_watchos_sdk_version": str | None,
    "default_visionos_sdk_version": str | None,
    "sdk_variant_info": XcodeSdkVariantInfo | None,
}]

def _xcode_version_properties_info_init(
    *,
    xcode_version: str | None,
    default_ios_sdk_version: str | None = ...,
    default_macos_sdk_version: str | None = ...,
    default_tvos_sdk_version: str | None = ...,
    default_watchos_sdk_version: str | None = ...,
    default_visionos_sdk_version: str | None = ...,
    sdk_variant_info: XcodeSdkVariantInfo | None = ...,
) -> _XcodeVersionPropertiesFields: ...
