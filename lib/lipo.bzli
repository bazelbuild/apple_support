"""Inputs for actions that assemble and extract universal binaries."""

# TODO(https://github.com/bazelbuild/bazel/issues/32343): Move these signatures into lipo.bzl when the
# action interface can describe the run_shell keywords in source. A type comment
# cannot import RunShellActions from apple_support.bzli.

load("//lib:apple_support.bzli", _Actions = "RunShellActions")
load("//lib/private:providers.bzl", "ApplePlatformInfo")

def _create(
        *,
        actions: _Actions,
        inputs: Sequence[File] | depset[File],
        output: File,
        apple_platform_info: ApplePlatformInfo | None = ...,
        apple_fragment: apple | None = ...,
        xcode_config: XcodeVersionConfig,
) -> None: ...

def _extract_or_thin(
        *,
        actions: _Actions,
        apple_platform_info: ApplePlatformInfo | None = ...,
        apple_fragment: apple | None = ...,
        archs: Sequence[str],
        input_shell_expression: str | None = ...,
        input_file: File | None = ...,
        output: File,
        xcode_config: XcodeVersionConfig,
) -> None: ...
